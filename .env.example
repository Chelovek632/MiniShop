# Скопируйте в .env и заполните свои значения:
#   cp .env.example .env
# .env НЕ коммитится (см. .gitignore)

# Пароль PostgreSQL (минимум 12 символов)
POSTGRES_PASSWORD=change-me-please

# JWT signing key: минимум 32 символа, сгенерируйте свой, например:
#   python -c "import secrets; print(secrets.token_hex(48))"
JWT_KEY=
